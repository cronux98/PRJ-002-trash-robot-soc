SIM = verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../../03_frontend-stage/rtl-i2c_ds3231/rtl/i2c_master.v
TOPLEVEL = i2c_master
COCOTB_TEST_MODULES = test_i2c_ds3231
COMPILE_ARGS = --coverage --coverage-line --coverage-toggle -Wno-fatal -Wno-WIDTH -Wno-UNUSED -Wno-UNOPTFLAT -Wno-DECLFILENAME -Wno-PINCONNECTEMPTY -Wno-PINMISSING -Wno-TIMESCALEMOD
EXTRA_ARGS = --trace --trace-vcd

include $(shell cocotb-config --makefiles)/Makefile.sim
