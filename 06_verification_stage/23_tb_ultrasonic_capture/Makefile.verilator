SIM = verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../../03_frontend-stage/rtl-ultrasonic_capture/rtl/ultrasonic_capture.v
TOPLEVEL = ultrasonic_capture
COCOTB_TEST_MODULES = test_ultrasonic_capture
COMPILE_ARGS = --coverage --coverage-line --coverage-toggle -Wno-fatal -Wno-WIDTH -Wno-UNUSED -Wno-UNOPTFLAT -Wno-DECLFILENAME -Wno-PINCONNECTEMPTY -Wno-PINMISSING -Wno-TIMESCALEMOD
EXTRA_ARGS = --trace --trace-vcd

include $(shell cocotb-config --makefiles)/Makefile.sim
