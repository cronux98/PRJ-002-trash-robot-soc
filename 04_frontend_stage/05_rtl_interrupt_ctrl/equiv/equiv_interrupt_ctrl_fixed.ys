hierarchy -top interrupt_ctrl
setattr -mod -unset whitebox =*
setattr -mod -unset blackbox =*
proc
flatten
async2sync
rename interrupt_ctrl gate_interrupt_ctrl
design -save gate_saved
design -pop

# EQUIV
design -copy-from gate_saved gate_interrupt_ctrl gate_interrupt_ctrl
equiv_make -inames gold_interrupt_ctrl gate_interrupt_ctrl equiv
equiv_simple -seq 10
equiv_induct -seq 10
equiv_status -assert
