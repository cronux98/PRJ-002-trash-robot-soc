# GOLD: RTL -> generic (flattened, async2sync'd)
read_verilog /home/smdadmin/hermes_workspace/projects/IP-005/v6/03_frontend-stage/rtl-gpio//rtl/gpio.v
hierarchy -top gpio
synth -flatten -top gpio
async2sync
rename gpio gold_gpio
design -push

# GATE: sky130 netlist with WHITEBOX liberty models
read_liberty -wb -ignore_miss_func -ignore_miss_dir /home/smdadmin/.ciel/ciel/sky130/versions/8afc8346a57fe1ab7934ba5a6056ea8b43078e71/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog /home/smdadmin/hermes_workspace/projects/IP-005/v6/03_frontend-stage/rtl-gpio//synth/gpio_netlist.v
hierarchy -top gpio
setattr -mod -unset whitebox =*
setattr -mod -unset blackbox =*
proc
flatten
async2sync
rename gpio gate_gpio
design -save gate_saved
design -pop

# EQUIV
design -copy-from gate_saved gate_gpio gate_gpio
equiv_make -inames gold_gpio gate_gpio equiv
equiv_simple -seq 10
equiv_induct -seq 10
equiv_status -assert
