  connect \wdt_rst_n_int \wdt_inst.rst_out_n
  connect \weight_inst.clk_i \clk_i
  connect \weight_inst.rst_ni \pm_inst.sys_rst_n_o
  connect \weight_inst.wb_adr_i \picorv32_inst.mem_addr
  connect \weight_inst.wb_dat_i \picorv32_inst.mem_wdata
  connect \weight_inst.wb_sel_i \picorv32_inst.mem_wstrb
  connect \weight_inst.wb_stb_i \weight_inst.wb_cyc_i
  connect \weight_inst.wb_we_i \pm_inst.wb_we_i
end
