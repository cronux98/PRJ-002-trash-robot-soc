hierarchy -top uart
rename uart gate_uart
design -save gate_saved
design -pop

# EQUIV
design -copy-from gate_saved gate_uart gate_uart
equiv_make -inames gold_uart gate_uart equiv
equiv_simple -seq 10
equiv_induct -seq 10
equiv_status
