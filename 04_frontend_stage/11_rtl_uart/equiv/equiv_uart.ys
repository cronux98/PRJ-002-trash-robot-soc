# GOLD: RTL -> generic
read_verilog /home/smdadmin/hermes_workspace/projects/IP-005/v5/03_frontend-stage/rtl-uart/rtl/uart.v
hierarchy -top uart
synth -top uart
rename uart gold_uart
design -push

# GATE: netlist (sky130)
read_liberty -ignore_miss_func -lib /home/smdadmin/.ciel/ciel/sky130/versions/8afc8346a57fe1ab7934ba5a6056ea8b43078e71/sky130B/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
