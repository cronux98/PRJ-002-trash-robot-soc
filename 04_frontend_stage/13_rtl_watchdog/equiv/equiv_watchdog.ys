# GOLD: RTL -> generic
read_verilog ~/hermes_workspace/projects/IP-005/v5/03_frontend-stage/rtl-watchdog/rtl/watchdog.v
hierarchy -top watchdog
synth -top watchdog
rename watchdog gold_watchdog
